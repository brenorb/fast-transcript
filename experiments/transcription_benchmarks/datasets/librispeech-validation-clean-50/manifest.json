{
  "dataset": "openslr/librispeech_asr",
  "revision": "71cacbfb7e2354c4226d01e70d77d5fca3d04ba1",
  "config": "clean",
  "split": "validation",
  "selection": "Dataset Viewer rows 0–49",
  "fetched_at": "2026-09-30T12:53:25.657679+00:00",
  "audio_seconds": 232.005,
  "reference_words": 789,
  "utterances": [
    {
      "id": "2277-149896-0000",
      "row_index": 0,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE WAS IN A FEVERED STATE OF MIND OWING TO THE BLIGHT HIS WIFE'S ACTION THREATENED TO CAST UPON HIS ENTIRE FUTURE",
      "audio_path": "audio/2277-149896-0000.wav",
      "audio_seconds": 6.59,
      "wav_sha256": "edf01562668e4ca4ee0db5fbe84771a97093e03e6c5602779f0d747fc35d228b",
      "flac_sha256": "fead3e0c481f1c637fe6ec8edef42506c7c2d33a3fb7519bfdf5815b31150303"
    },
    {
      "id": "2277-149896-0001",
      "row_index": 1,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE WOULD HAVE TO PAY HER THE MONEY WHICH SHE WOULD NOW REGULARLY DEMAND OR THERE WOULD BE TROUBLE IT DID NOT MATTER WHAT HE DID",
      "audio_path": "audio/2277-149896-0001.wav",
      "audio_seconds": 7.145,
      "wav_sha256": "eca11f1856d5f9b7c8f24f69185e276386ba10f2fb59683df9b54abfda8ce338",
      "flac_sha256": "f9c3371b4d1c6e95e7c01298a26215c2be97bee22c5408885d8d29b6e0e4171c"
    },
    {
      "id": "2277-149896-0002",
      "row_index": 2,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HURSTWOOD WALKED THE FLOOR MENTALLY ARRANGING THE CHIEF POINTS OF HIS SITUATION",
      "audio_path": "audio/2277-149896-0002.wav",
      "audio_seconds": 4.835,
      "wav_sha256": "7a1c9fbd93d5d5acc99932dbe743e95009214daa48651f8e8eb0bc864029b0e4",
      "flac_sha256": "ade2caad47934462292358ba49acf7f048ced0595615492b4b20866d118bf901"
    },
    {
      "id": "2277-149896-0003",
      "row_index": 3,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE ALSO THOUGHT OF HIS MANAGERIAL POSITION",
      "audio_path": "audio/2277-149896-0003.wav",
      "audio_seconds": 2.84,
      "wav_sha256": "b26df78de7e2761d52dfbbb0116662856b97329145aa09cf95e47229b4372de6",
      "flac_sha256": "a99595b53e5d48524c2ba4903071f2498b05c25c509f0a78d60dc15ee46a4836"
    },
    {
      "id": "2277-149896-0004",
      "row_index": 4,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HOW WOULD THE PAPERS TALK ABOUT IT",
      "audio_path": "audio/2277-149896-0004.wav",
      "audio_seconds": 1.955,
      "wav_sha256": "1bc8f880c7db0491719ea20befdaf410309005185af3462c8c8b40c2046b3130",
      "flac_sha256": "ed54e3c104353811fe907ea4042fca210ee4dc2db29067ee7d29b9a51c954a46"
    },
    {
      "id": "2277-149896-0005",
      "row_index": 5,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "MANY LITTLE WRINKLES GATHERED BETWEEN HIS EYES AS HE CONTEMPLATED THIS AND HIS BROW MOISTENED",
      "audio_path": "audio/2277-149896-0005.wav",
      "audio_seconds": 5.6,
      "wav_sha256": "ff51d3f7cb20114c7972f7e9fe4ec6bf0d9d5d7cdef7d356bb6cf240d8c78da5",
      "flac_sha256": "05013da97856ccce8ef62b3408643f144ae6b88d581731675fd1a70b03288849"
    },
    {
      "id": "2277-149896-0006",
      "row_index": 6,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE COULD ARRANGE THAT SATISFACTORILY FOR CARRIE WOULD BE GLAD TO WAIT IF NECESSARY",
      "audio_path": "audio/2277-149896-0006.wav",
      "audio_seconds": 4.97,
      "wav_sha256": "dcf7cee900f4b5b075255eaba7fa4ec176b6c841791ad4531aeadfc7da2ad368",
      "flac_sha256": "3d63f01a67b524514d7bee6b966b58d4b6f18f6cfa1f92c847353b824593ee8c"
    },
    {
      "id": "2277-149896-0007",
      "row_index": 7,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE WOULD SEE HOW THINGS TURNED OUT TO MORROW AND THEN HE WOULD TALK TO HER THEY WERE GOING TO MEET AS USUAL",
      "audio_path": "audio/2277-149896-0007.wav",
      "audio_seconds": 5.375,
      "wav_sha256": "78c4b2226dc037cf313b9fda396d58c50cf911421737578080eb9fd7edde146a",
      "flac_sha256": "addaf4f4264c7db2284e5517d1120f22c2b39c1bc58bbc46bc4f3625666891b4"
    },
    {
      "id": "2277-149896-0008",
      "row_index": 8,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "FOR SOME REASON HE FELT AS IF SOMETHING MIGHT COME THAT WAY AND WAS RELIEVED WHEN ALL THE ENVELOPES HAD BEEN SCANNED AND NOTHING SUSPICIOUS NOTICED",
      "audio_path": "audio/2277-149896-0008.wav",
      "audio_seconds": 6.94,
      "wav_sha256": "01aa1c5f13f42cca9b72866026eca3d84160609cb676898e98bc2bc986a6107b",
      "flac_sha256": "fff4a9ac06e5a85348e1d12a498da564c7de250917e8733577b86f64cec7198c"
    },
    {
      "id": "2277-149896-0009",
      "row_index": 9,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "WHILE THE DANGER HAD NOT LESSENED IT HAD NOT AS YET MATERIALISED AND WITH HIM NO NEWS WAS GOOD NEWS",
      "audio_path": "audio/2277-149896-0009.wav",
      "audio_seconds": 5.815,
      "wav_sha256": "fd1e9e5ea9c49974ca1e5d8d6c697f0d8826822c58b0c48a02d74911b4106c83",
      "flac_sha256": "91f02445f3a28cf518aaf8667368e1aba09997cca55208a40bddf1d2d1f2936e"
    },
    {
      "id": "2277-149896-0010",
      "row_index": 10,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "SO LITTLE DID HE CONSIDER DROUET THAT IT NEVER ONCE OCCURRED TO HIM TO WORRY ABOUT HIS FINDING OUT",
      "audio_path": "audio/2277-149896-0010.wav",
      "audio_seconds": 5.275,
      "wav_sha256": "6bb289728541427c3e035b2be4bca9651e6d0ead8021910df801d5d4f8ff166d",
      "flac_sha256": "13151a1366282c4b67916c6c266663ee52c84c88a0df264085066668b0ea0573"
    },
    {
      "id": "2277-149896-0011",
      "row_index": 11,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE GREW RESTLESS AS HE RUMINATED AND THEN DECIDED THAT PERHAPS IT WAS NOTHING",
      "audio_path": "audio/2277-149896-0011.wav",
      "audio_seconds": 4.465,
      "wav_sha256": "665ba5d979b96ee56d14d8bc5e2c635cdc02151a6f9a2494657908f562138457",
      "flac_sha256": "1c4046f47f1398e9cc33f3bb673c4802f8baa5c018172d5acbb2c625802bfb6a"
    },
    {
      "id": "2277-149896-0012",
      "row_index": 12,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "SHE HAD NOT BEEN ABLE TO GET AWAY THIS MORNING",
      "audio_path": "audio/2277-149896-0012.wav",
      "audio_seconds": 2.495,
      "wav_sha256": "569a2a1b0db5a9361666cff1bd887f0d78ed00707707bd08541c14b80d6838db",
      "flac_sha256": "33382f7634da27eeba65f1e8f945672c9ed3a9cf8c005e53e7f30cd53555f4f0"
    },
    {
      "id": "2277-149896-0013",
      "row_index": 13,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE WOULD GET ONE TO DAY IT WOULD PROBABLY BE ON HIS DESK WHEN HE GOT BACK HE WOULD LOOK FOR IT AT ONCE",
      "audio_path": "audio/2277-149896-0013.wav",
      "audio_seconds": 6.09,
      "wav_sha256": "63cbcdfffae7adb26d4934e11310654bb6a5d66adb23103f4828bb996c51cca4",
      "flac_sha256": "91d24f91ba4da2e1d10c302f4fc624ecda2bb73577e1dc1642d28613667a3dd8"
    },
    {
      "id": "2277-149896-0014",
      "row_index": 14,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "AFTER A TIME HE GAVE UP WAITING AND DREARILY HEADED FOR THE MADISON CAR",
      "audio_path": "audio/2277-149896-0014.wav",
      "audio_seconds": 4.07,
      "wav_sha256": "2617d226aff07c5b69931a16eb3a4835c710414494a57f807a873e83e652bfd5",
      "flac_sha256": "759e0c012e13e7394478aa50535bd3a0a59078044101ae50ebd417bafc28f848"
    },
    {
      "id": "2277-149896-0015",
      "row_index": 15,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE WENT IN AND EXAMINED HIS LETTERS BUT THERE WAS NOTHING FROM CARRIE",
      "audio_path": "audio/2277-149896-0015.wav",
      "audio_seconds": 3.675,
      "wav_sha256": "dbaa579fdca072d43e2a1b23c59f3995c4bbae192e59c4921dce8d70baaabb1f",
      "flac_sha256": "d626ac1858e0a373bcd84d81a631ebe57ff7fea3fc83beae15bcc613d6e3c179"
    },
    {
      "id": "2277-149896-0016",
      "row_index": 16,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "FORTUNATELY THERE WAS NOTHING FROM HIS WIFE EITHER",
      "audio_path": "audio/2277-149896-0016.wav",
      "audio_seconds": 2.785,
      "wav_sha256": "9978f96e2c647ce4501f93344f2b116a6d5010159404bfe7962a924cdbecbd3b",
      "flac_sha256": "35535a9a29d599998fb7addaa884a9272da4a80f2e92487008b4bcb66e2b7dfa"
    },
    {
      "id": "2277-149896-0017",
      "row_index": 17,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "AT ONE THIRTY HE WENT TO RECTOR'S FOR LUNCH AND WHEN HE RETURNED A MESSENGER WAS WAITING FOR HIM",
      "audio_path": "audio/2277-149896-0017.wav",
      "audio_seconds": 4.985,
      "wav_sha256": "3808558a28e07d3ed2d92269a5a9a3a6428d14ffc76e95ee86b37c7bf67f1470",
      "flac_sha256": "b92316c9aa49903883f601ffcbfe67a7647569be7454aa59c10467228f4cefca"
    },
    {
      "id": "2277-149896-0018",
      "row_index": 18,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HIS FIRST IMPULSE WAS TO WRITE BUT FOUR WORDS IN REPLY GO TO THE DEVIL",
      "audio_path": "audio/2277-149896-0018.wav",
      "audio_seconds": 4.545,
      "wav_sha256": "94059fe42899e781b38558f697370ed716c8863e1172077b97aac0f99f1871ab",
      "flac_sha256": "6a52810a9b4656d86ef50cda41415f6d242e43939e0c501b9a02c63b9a869461"
    },
    {
      "id": "2277-149896-0019",
      "row_index": 19,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "BUT HE COMPROMISED BY TELLING THE BOY THAT THERE WOULD BE NO REPLY",
      "audio_path": "audio/2277-149896-0019.wav",
      "audio_seconds": 3.56,
      "wav_sha256": "26e0b5bf9d5a58f319fb5a10f05c10f7acbc2ccaf617bbf038e13a20705c208c",
      "flac_sha256": "5eb7bd90711107c2910b74d43f164ef66b162de88106c6ef610c2a8fe1139bf3"
    },
    {
      "id": "2277-149896-0020",
      "row_index": 20,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "THEN HE SAT DOWN IN HIS CHAIR AND GAZED WITHOUT SEEING CONTEMPLATING THE RESULT OF HIS WORK",
      "audio_path": "audio/2277-149896-0020.wav",
      "audio_seconds": 5.285,
      "wav_sha256": "cc0261e292b1e432c83555a83b74c5c2576c503ab684434804494969fbdea769",
      "flac_sha256": "481571f0d52f21ede512820e9e8173ff8cbcdb1176b40c80c47d390d3f2ab9f4"
    },
    {
      "id": "2277-149896-0021",
      "row_index": 21,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "WHAT WOULD SHE DO ABOUT THAT THE CONFOUNDED WRETCH",
      "audio_path": "audio/2277-149896-0021.wav",
      "audio_seconds": 3.37,
      "wav_sha256": "04f68209dc1bded9de438da704062fa6627742d1d75cdcd1b0c0d2f61eecb0ea",
      "flac_sha256": "c6bcb66167d4562cf90e876dead087625d1ac5058656bd053432266f54933044"
    },
    {
      "id": "2277-149896-0022",
      "row_index": 22,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "LATER HOWEVER HIS OLD DISCRETION ASSERTED ITSELF",
      "audio_path": "audio/2277-149896-0022.wav",
      "audio_seconds": 3.38,
      "wav_sha256": "1a9273cd80f1287e96496a988320d81d95d305e29975e484e9fe1f2ac24f2290",
      "flac_sha256": "f0bebc7b9765d2d1a62ed0e6ea86062757a309c9de9093e8d4ace52eebeddbe4"
    },
    {
      "id": "2277-149896-0023",
      "row_index": 23,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "SOMETHING HAD TO BE DONE A CLIMAX WAS NEAR AND SHE WOULD NOT SIT IDLE",
      "audio_path": "audio/2277-149896-0023.wav",
      "audio_seconds": 3.89,
      "wav_sha256": "53c1a35e7d07fc78d87a068d7c3516ba3da3808c8c43e8b5bd6d7b451f82ab4d",
      "flac_sha256": "4ae7a40d4cd554616da367bc0464a56caee0658ea5af7db328ee03ae1a5964c4"
    },
    {
      "id": "2277-149896-0024",
      "row_index": 24,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE KNEW HER WELL ENOUGH TO KNOW THAT WHEN SHE HAD DECIDED UPON A PLAN SHE WOULD FOLLOW IT UP",
      "audio_path": "audio/2277-149896-0024.wav",
      "audio_seconds": 4.5,
      "wav_sha256": "d602c2600bb48db9d75f707606831dd84b590e260d8ea55c013f8dc615996ef8",
      "flac_sha256": "d67e8a52aaee3822c461bb21eda0cbbb61201a67c03700f6f44d4814bbceeaa5"
    },
    {
      "id": "2277-149896-0025",
      "row_index": 25,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE AROSE FROM HIS CHAIR AND WENT AND LOOKED OUT INTO THE STREET",
      "audio_path": "audio/2277-149896-0025.wav",
      "audio_seconds": 3.4,
      "wav_sha256": "70fa56bdfb47a590e32f4fdde37dc4ead43a72eecb8c2fd7b0ecbff497633064",
      "flac_sha256": "066ec5202db09f1f0877e295a914d2d71a2dbcb6a739c70bc44a2687ea9e8f94"
    },
    {
      "id": "2277-149896-0026",
      "row_index": 26,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "THE LONG DRIZZLE HAD BEGUN PEDESTRIANS HAD TURNED UP COLLARS AND TROUSERS AT THE BOTTOM",
      "audio_path": "audio/2277-149896-0026.wav",
      "audio_seconds": 4.92,
      "wav_sha256": "8231f9ec1b79bef07f3f2bbd5548c7ab8fff79a1e0bb774eab08507104be2381",
      "flac_sha256": "3909a6c5ae93112518681fcbf0a74df43615a4f88bd6d5cd788775255296e3f6"
    },
    {
      "id": "2277-149896-0027",
      "row_index": 27,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HURSTWOOD ALMOST EXCLAIMED OUT LOUD AT THE INSISTENCY OF THIS THING",
      "audio_path": "audio/2277-149896-0027.wav",
      "audio_seconds": 3.595,
      "wav_sha256": "ec390eb3d274d2629a7c178fb23582540974e5668931bcaf79132f60221d3d1e",
      "flac_sha256": "a4831606b567c1a81940e11ccafa0ae14767ab43dde5ce7dbba56d54500bb13e"
    },
    {
      "id": "2277-149896-0028",
      "row_index": 28,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE PUT ON HIS HAT AND LOOKED AROUND FOR HIS UMBRELLA",
      "audio_path": "audio/2277-149896-0028.wav",
      "audio_seconds": 2.9,
      "wav_sha256": "e1dd96cf06c5ece651193a0d307f490b761f8445a22b9f1775087db54c91f023",
      "flac_sha256": "1329424372f495a29b6f58485b377bbda860056606425f15c2f402afdb1d98af"
    },
    {
      "id": "2277-149896-0029",
      "row_index": 29,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE WOULD HAVE SOME ARRANGEMENT OF THIS THING",
      "audio_path": "audio/2277-149896-0029.wav",
      "audio_seconds": 2.6,
      "wav_sha256": "48a331a8c85c96e0975f0613c62e36c6cccb5504eda41bec5bbe3fd87d9c3280",
      "flac_sha256": "d5d2cc220666c813bc7e7742626d9e780a4fed5e2227bd74f8f1e385a98cfaa2"
    },
    {
      "id": "2277-149896-0030",
      "row_index": 30,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE BEGAN TO WISH THAT HE HAD COMPROMISED IN SOME WAY OR OTHER THAT HE HAD SENT THE MONEY PERHAPS HE COULD DO IT UP HERE",
      "audio_path": "audio/2277-149896-0030.wav",
      "audio_seconds": 6.3,
      "wav_sha256": "686c27dae89575484f7289cd674c66d858e50dd2f7cd9bbadd719abc9fb10788",
      "flac_sha256": "c6344911546ea7bfc243fba7e723f6d20bf89328629080100459924a81acdd32"
    },
    {
      "id": "2277-149896-0031",
      "row_index": 31,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE WOULD GO IN AND SEE ANYHOW HE WOULD HAVE NO ROW",
      "audio_path": "audio/2277-149896-0031.wav",
      "audio_seconds": 3.61,
      "wav_sha256": "91d7977caab547be7185193177d661745386fdef3ad979fe5d7ce1fb32d8b97d",
      "flac_sha256": "74a08b4880512f6e43f5f2e45eaf2b6078184f46a89f6b862a2eb1c5f25ebbcd"
    },
    {
      "id": "2277-149896-0032",
      "row_index": 32,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "BY THE TIME HE REACHED HIS OWN STREET HE WAS KEENLY ALIVE TO THE DIFFICULTIES OF HIS SITUATION AND WISHED OVER AND OVER THAT SOME SOLUTION WOULD OFFER ITSELF THAT HE COULD SEE HIS WAY OUT",
      "audio_path": "audio/2277-149896-0032.wav",
      "audio_seconds": 10.77,
      "wav_sha256": "3ea2eeb7c87d463328fb1fc5c55306e003061526d7e9fb783e328e0bd25ce04c",
      "flac_sha256": "56b640a079f27f9473478a20f068b8bd8af3afa7030d7a07cbbc7b3f19211689"
    },
    {
      "id": "2277-149896-0033",
      "row_index": 33,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "THEN HE RANG THE BELL NO ANSWER",
      "audio_path": "audio/2277-149896-0033.wav",
      "audio_seconds": 2.845,
      "wav_sha256": "ef4d0aa05abc4ba4f4b3ec98a21dec99da7a3cf1c37e4c1c6c40401eb7d57c2a",
      "flac_sha256": "23009ec1ed5c704bb4b1c0bc75953121f38b2a2136cf8380f98e512517427473"
    },
    {
      "id": "2277-149896-0034",
      "row_index": 34,
      "speaker_id": 2277,
      "chapter_id": 149896,
      "text": "HE RANG AGAIN THIS TIME HARDER STILL NO ANSWER",
      "audio_path": "audio/2277-149896-0034.wav",
      "audio_seconds": 4.005,
      "wav_sha256": "f0d5365e941c05f01754dcd5f370446c759b02e04287454ef133530283dfa370",
      "flac_sha256": "aa063190b3125aa8400908460213bafb71226b4980bef44b81c7dd2658cebacb"
    },
    {
      "id": "2277-149897-0000",
      "row_index": 35,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "WHEN HURSTWOOD GOT BACK TO HIS OFFICE AGAIN HE WAS IN A GREATER QUANDARY THAN EVER",
      "audio_path": "audio/2277-149897-0000.wav",
      "audio_seconds": 4.395,
      "wav_sha256": "88fa1abe4a294c611fe05cc8f008391af582ac91a949d3eeb081506e4ecd05fc",
      "flac_sha256": "0a55b7ad334c84d74b93fcbc35319fc5ddd9e6be92a08d15382f810bff356927"
    },
    {
      "id": "2277-149897-0001",
      "row_index": 36,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "HE COULD HARDLY REALISE HOW IT HAD ALL COME ABOUT",
      "audio_path": "audio/2277-149897-0001.wav",
      "audio_seconds": 2.755,
      "wav_sha256": "a36e2091ec9953677c462dc5f8527befb7fb0d03dc38e70e884bed8215daac36",
      "flac_sha256": "06ea43238e1c4a3ef1f8a70d6837081ebde7f2a9ace69134d153bebba4796e6e"
    },
    {
      "id": "2277-149897-0002",
      "row_index": 37,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "NO LETTER HAD COME NO WORD OF ANY KIND AND YET HERE IT WAS LATE IN THE EVENING AND SHE HAD AGREED TO MEET HIM THAT MORNING",
      "audio_path": "audio/2277-149897-0002.wav",
      "audio_seconds": 6.54,
      "wav_sha256": "e720a215d0a4a849bf0cfa2a2feefc22fc392e45e8052b3a4c2bba1bfda5d9a5",
      "flac_sha256": "e4539cedd5df0dad08d18d2ec97dabf8e816c2ff1e1879eb285d04b004100e9b"
    },
    {
      "id": "2277-149897-0003",
      "row_index": 38,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "HE SAW THAT IN THE EXCITEMENT OF RECENT EVENTS HE HAD NOT FORMULATED A PLAN UPON THAT SCORE",
      "audio_path": "audio/2277-149897-0003.wav",
      "audio_seconds": 4.84,
      "wav_sha256": "1b83651a0d70a81d9abdd404c4a7f5652acda7077cf01f4ce7fdda9c83941896",
      "flac_sha256": "267cbb4cd0d6b3637bf7bc3c02b7bcb5fc2d511fe1a47ae8af90c9fd01b904e0"
    },
    {
      "id": "2277-149897-0004",
      "row_index": 39,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "HE WAS GETTING SOME VAGUE COMFORT OUT OF A GOOD CIGAR BUT IT WAS NO PANACEA FOR THE ILL WHICH AFFECTED HIM",
      "audio_path": "audio/2277-149897-0004.wav",
      "audio_seconds": 5.735,
      "wav_sha256": "a56e9bd0a01dad0f86ffa694ce04a91c09cfbde312101b958ae88e2f4f3bcbd1",
      "flac_sha256": "17640624db003ade3594f26889f385b21085c4752a712d6262b94b47984de4ad"
    },
    {
      "id": "2277-149897-0005",
      "row_index": 40,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "IT WAS WITH GREAT OPPOSITION AFTER TWO OR THREE HOURS OF THE MOST URGENT MENTAL AFFIRMATION AND DENIAL THAT AT LAST HE GOT AN ENVELOPE PLACED IN IT THE REQUESTED AMOUNT AND SLOWLY SEALED IT UP",
      "audio_path": "audio/2277-149897-0005.wav",
      "audio_seconds": 11.465,
      "wav_sha256": "37770ec0bd844ea75b3a67b3a812b743ab37271043b98d9940cfd340f0365333",
      "flac_sha256": "61a532c7d431449bfc8d5ed7573007007abd3407d1a16254762ae50f5c9fe56d"
    },
    {
      "id": "2277-149897-0006",
      "row_index": 41,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "THEN HE CALLED HARRY THE BOY OF ALL WORK AROUND THE PLACE",
      "audio_path": "audio/2277-149897-0006.wav",
      "audio_seconds": 3.385,
      "wav_sha256": "5d52efb44fbc330a67ebbb3f19832bf3cfbedcada7c6e1221e85e96b4c5bbde1",
      "flac_sha256": "40182afb9d9dfd0aac09f52ef00968f1b19a9bc7711295b0e79819c6241822e3"
    },
    {
      "id": "2277-149897-0007",
      "row_index": 42,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "YOU TAKE THIS TO THIS ADDRESS HE SAID HANDING HIM THE ENVELOPE AND GIVE IT TO MISSUS HURSTWOOD YES SIR SAID THE BOY",
      "audio_path": "audio/2277-149897-0007.wav",
      "audio_seconds": 7.855,
      "wav_sha256": "35012b8d2cadb74031218065868e37b622759ee52dff0bef063eb273bf6d9e34",
      "flac_sha256": "0d7095a40059b8483156960379ea8f29446eac83a25ba9ef202f96e203dfc0db"
    },
    {
      "id": "2277-149897-0008",
      "row_index": 43,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "ANY ANSWER I GUESS NOT",
      "audio_path": "audio/2277-149897-0008.wav",
      "audio_seconds": 2.88,
      "wav_sha256": "b4e7a57bf87a431d674d80c734444e60652e142e98c16256bfd80a359c415501",
      "flac_sha256": "7b09477d905507228b096594645a3abfc364b82c7d34424deeb76b60df71a033"
    },
    {
      "id": "2277-149897-0009",
      "row_index": 44,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "THE BOY HASTENED AWAY AND THE MANAGER FELL TO HIS MUSINGS",
      "audio_path": "audio/2277-149897-0009.wav",
      "audio_seconds": 3.725,
      "wav_sha256": "4c92e7d09dfc78907c6c37f8ab8fcf3208dc18481cb10392d50f2896b1affc5b",
      "flac_sha256": "2d187c2a00657a0c90f4cf5f3206d15d8d0da5a18d510638c4a1313b403288fe"
    },
    {
      "id": "2277-149897-0010",
      "row_index": 45,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "HE WAS BEATEN FOR TO NIGHT AND HE MIGHT JUST AS WELL MAKE THE BEST OF IT",
      "audio_path": "audio/2277-149897-0010.wav",
      "audio_seconds": 3.625,
      "wav_sha256": "73f0da643545969e3e32cc0f38d0be15e7fe041b07e790bc06c53cc9e04f7952",
      "flac_sha256": "128bc98e3f0d8429ecb292adfddf6be7d50c05fc5fa21628c059aed66bbc56fc"
    },
    {
      "id": "2277-149897-0011",
      "row_index": 46,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "SHE WOULD TAKE THE ENVELOPE AND KNOW THAT SHE HAD TRIUMPHED",
      "audio_path": "audio/2277-149897-0011.wav",
      "audio_seconds": 3.3,
      "wav_sha256": "7afe61e35b4fefb3527e2b5393561afde36abcff20fb4da541646d2f3fd25fbe",
      "flac_sha256": "63536024bf7e49966969ddd6f31bc31de9a96b3765c814dc2cf7d1c198a6ba6b"
    },
    {
      "id": "2277-149897-0012",
      "row_index": 47,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "IF HE ONLY HAD THAT LETTER BACK HE WOULDN'T SEND IT",
      "audio_path": "audio/2277-149897-0012.wav",
      "audio_seconds": 3.09,
      "wav_sha256": "0025b6c09b4c14f4d16bf7ab8ef6f2dbdcfa8fdb1c568a8af35bef9ac5fd9f9a",
      "flac_sha256": "e2576eb48c377e54e5ec160b1f9103b577424db91810240b23f2ac17cf86b199"
    },
    {
      "id": "2277-149897-0013",
      "row_index": 48,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "FOR RELIEF HE AROSE AND JOINED IN CONVERSATION WITH A FEW FRIENDS WHO WERE DRINKING",
      "audio_path": "audio/2277-149897-0013.wav",
      "audio_seconds": 4.415,
      "wav_sha256": "34584adb41e725a9bd195a7e7f17adf35c5ddeb86d4234529e208dd1b5d7276f",
      "flac_sha256": "f048aaf0091e02b7c2fdc730a5d02b498e5141c623fc66296a583a5b275c0b06"
    },
    {
      "id": "2277-149897-0014",
      "row_index": 49,
      "speaker_id": 2277,
      "chapter_id": 149897,
      "text": "ALL THE TIME HIS THOUGHTS WOULD RUN OUT TO HIS HOME AND SEE THE SCENE BEING THEREIN ENACTED",
      "audio_path": "audio/2277-149897-0014.wav",
      "audio_seconds": 4.62,
      "wav_sha256": "4903a4bd89ceec4346ee2961d54b22ace2d785c7b22653ffda020782a524f721",
      "flac_sha256": "d1a3c56e2a1002533ca8a855012841eefc0b3367465e4af9876151e407d2c89b"
    }
  ],
  "normalization": "lowercase; remove non-ASCII-alphanumeric punctuation; split whitespace"
}
